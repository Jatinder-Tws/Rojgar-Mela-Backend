# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://jobmatch:secret@localhost:5432/jobmatch_db


# ─── JWT ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Super admin portal (seeded on API startup if account does not exist)
SUPER_ADMIN_EMAIL=superadmin@hirely.com
SUPER_ADMIN_PASSWORD=change-me
SUPERADMIN_SECRET_KEY=change-this-superadmin-secret

# ─── OpenAI / Gemini AI Provider ────────────────────────────────────────────
# AI_MODE controls which provider is used:
#   "gemini" → Google Gemini only (requires GOOGLE_API_KEY)
#   "openai" → OpenAI only (requires OPENAI_API_KEY)
#   "hybrid" → Gemini first, falls back to OpenAI on failure (requires both keys)
#   "mock"   → No API calls (offline dev mode)
AI_MODE=gemini

# ─── Google Gemini ──────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash

# ─── OpenAI (optional, only needed if AI_MODE=openai or hybrid) ─────────────
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o

# ─── SMTP Mail ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=JobMatch AI <your-email@gmail.com>
SMTP_TLS=true

# ─── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ───────────────────────────────────────────────────────────────────
# Must match the URL in the browser address bar (scheme + host + port, no path).
# Production example: FRONTEND_URL=https://jobs.example.com
FRONTEND_URL=http://localhost:5173
# Optional: extra origins (comma-separated), e.g. IP + port or second domain
# CORS_ORIGINS=http://203.0.113.10:4173,https://staging.example.com
# Optional: override or disable LAN regex (default allows 192.168.x.x / 10.x / 172.16–31.x with any port)
# CORS_ORIGIN_REGEX=none

# ─── File Storage ───────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ─── Auto-match threshold ────────────────────────────────────────────────────
AUTO_MATCH_THRESHOLD=0.70
PROVIDER_MATCH_THRESHOLD=0.75
