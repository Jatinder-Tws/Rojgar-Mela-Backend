# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://jobmatch:secret@localhost:5432/jobmatch_db


# ─── JWT ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Super admin portal (seeded on API startup if account does not exist)
SUPER_ADMIN_EMAIL=superadmin@rojgarmela.ai
SUPER_ADMIN_PASSWORD=change-me
SUPERADMIN_SECRET_KEY=change-this-superadmin-secret

# ─── OpenAI / Gemini AI Provider ────────────────────────────────────────────
# AI_MODE controls which provider is used:
#   "gemini" → Google Gemini only (requires GOOGLE_API_KEY)
#   "openai" → OpenAI only (requires OPENAI_API_KEY)
#   "hybrid" → Gemini first, falls back to OpenAI on failure (requires both keys)
#   "mock"   → No API calls (offline dev mode)
AI_MODE=gemini

# ─── Google Gemini ──────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key

# ─── YouTube Data API (free course playlist import) ─────────────────────────
# Optional. Create a key in Google Cloud Console with YouTube Data API v3 enabled.
# If empty, backend falls back to yt-dlp extract-only (no video download).
YOUTUBE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# ─── OpenAI (optional, only needed if AI_MODE=openai or hybrid) ─────────────
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o

# ─── SMTP Mail (Mailtrap sandbox — https://mailtrap.io) ─────────────────────
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-smtp-username
SMTP_PASSWORD=your-mailtrap-smtp-password
SMTP_FROM=Rojgar Mela <noreply@rojgarmela.ai>
SMTP_TLS=true

# ─── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Email verification OTP TTL (stored in Redis, not DB)
OTP_EXPIRE_MINUTES=5

# ─── CORS ───────────────────────────────────────────────────────────────────
# Must match the URL in the browser address bar (scheme + host + port, no path).
# Production example: FRONTEND_URL=https://jobs.example.com
FRONTEND_URL=http://localhost:5173
# Training portal origin — also added to CORS allow list automatically
TRAINING_URL=http://localhost:3000
# CORS_ORIGINS=http://203.0.113.10:4173,https://staging.example.com
# Optional: override or disable LAN regex (default allows 192.168.x.x / 10.x / 172.16–31.x with any port)
# CORS_ORIGIN_REGEX=none

# ─── File Storage ───────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# ─── Auto-match threshold ────────────────────────────────────────────────────
AUTO_MATCH_THRESHOLD=0.70
PROVIDER_MATCH_THRESHOLD=0.75

# ─── Razorpay (Training Portal payments) ─────────────────────────────────────
# Leave empty for dev mock-checkout; set all three for production + webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL in Razorpay dashboard: POST {API_BASE}/training-portal/runtime/payments/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ─── Google Calendar (Training class schedule sync) ──────────────────────────
# ICS email invites are sent to teachers + students whenever a class is
# scheduled/updated/cancelled (works with any SMTP config, no OAuth needed).
GOOGLE_CALENDAR_ICS_ENABLED=true
# Optional: per-user auto-sync. Create an OAuth 2.0 Client (type "Web application")
# in Google Cloud Console, enable the Google Calendar API, and paste the keys below.
# Add the redirect URI below to the client's "Authorized redirect URIs".
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/google-calendar/callback
# Where the user is sent back after connecting (defaults to TRAINING_URL).
GOOGLE_CALENDAR_POST_CONNECT_URL=

# Google Sign-In / Social Login (OAuth code flow)
# Add http://localhost:8000/auth/{google|github|linkedin}/callback to each provider's redirect URIs.
# GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:8000/auth/linkedin/callback
BACKEND_PUBLIC_URL=http://localhost:8000
TOKEN_ENCRYPTION_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
